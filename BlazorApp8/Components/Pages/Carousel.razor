@page "/Carousel"

<div class="slider">
    <div class="slides">
        <input type="radio" name="radio-btn" id="img-1" checked>
        <input type="radio" name="radio-btn" id="img-2">
        <input type="radio" name="radio-btn" id="img-3">
        <input type="radio" name="radio-btn" id="img-4">

        <div class="slide first">
            <!-- Replace the image link with your actual image link -->
            <img src="https://www.microsoft.com/en-kh/p/hackbot/9p7n112xn02v" />
        </div>
        <div class="slide">
            <img src="https://www.cnet.com/news/privacy/hacked-nsa-tools-put-windows-users-at-possible-risk/" />
        </div>
        <div class="slide">
            <img src="https://www.digit.fyi/thousands-of-credentials-stolen-in-global-windows-and-linux-hack/" />
        </div>
        <div class="slide">
            <img src="https://erp.today/microsoft-disables-windows-feature-amid-flurry-of-cyberattacks/" />
        </div>

        <div class="navigation-manual">
            <label for="img-1" class="manual-btn"></label>
            <label for="img-2" class="manual-btn"></label>
            <label for="img-3" class="manual-btn"></label>
            <label for="img-4" class="manual-btn"></label>
        </div>
    </div>
</div>
