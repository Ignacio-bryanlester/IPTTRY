@page "/Java"

<h3 class="carousel-title">✨ Featured Gallery</h3>

<div class="swiper mySwiper">
    <div class="swiper-wrapper">
        <div class="swiper-slide"><img src="images/images (1).jpg" /></div>
        <div class="swiper-slide"><img src="images/h2.jpg" /></div>
        <div class="swiper-slide"><img src="images/h1.jpg" /></div>
        <div class="swiper-slide"><img src="images/h2.jpg" /></div>
        <div class="swiper-slide"><img src="images/h1.jpg" /></div>
    </div>

    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeSwiper");
        }
    }

    [Inject] private IJSRuntime JSRuntime { get; set; }
}
